# Copie este arquivo para .env e preencha os valores.
# Nunca envie o arquivo .env para o GitHub.

NODE_ENV=production
PORT=3001

# URL publica da galeria (usada no QR Code)
PUBLIC_URL=https://seu-servico.onrender.com

# Segredo das sessoes. Gere com: openssl rand -hex 48
SESSION_SECRET=troque-por-um-segredo-longo

# Token unico para criar o primeiro administrador e recuperar senha.
# Gere com: openssl rand -hex 32
SETUP_TOKEN=troque-por-um-token-longo

# Pasta persistente (disco do Render ou volume local)
DATA_DIR=./data

# Banco: deixe vazio para SQLite em DATA_DIR/gallery.sqlite
# No Render, use a URL interna do PostgreSQL
DATABASE_URL=

# Armazenamento de midias: local ou s3
STORAGE_DRIVER=local

# Se STORAGE_DRIVER=s3 (Cloudflare R2, AWS S3 ou similar)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# Limites
MAX_PHOTO_MB=12
MAX_VIDEO_MB=80
MAX_FILES_PER_UPLOAD=10
